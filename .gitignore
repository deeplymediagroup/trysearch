# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never opt in here, this app holds App Store Connect keys
.env*

# App Store Connect private keys. In .gitignore from the FIRST commit, not the tenth.
*.p8
*.json.key
play-service-account*.json

# crawler output / local scratch
/.data/
/tmp/

# vercel — the folder carries the project link; copying it can overwrite another project's URL
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# The build spec contains a competitive teardown of a named third-party business,
# including revenue estimates and remarks about its founder. Kept local, out of the
# public repo. Backup: ../trysearch-spec-private-backup
docs/spec/
_*.mjs
